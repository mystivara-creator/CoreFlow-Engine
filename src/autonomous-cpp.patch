+bool readSignedLongLong(const std::string& path, long long& value) {
+    std::ifstream file(path);
+    if (!file)
+        return false;
+
+    file >> value;
+    return file.good() || file.eof();
+}
+
+void validateChargeControlLimit(ChargingCapability& charging) {
+    if (!charging.battery_available ||
+        !charging.has_charge_control_limit) {
+        logInfo("ChargingControlValidation available=NO");
+        return;
+    }
+
+    const std::string base =
+        charging.battery_path + "/charge_control_limit";
+    const std::string min_path =
+        charging.battery_path + "/charge_control_limit_min";
+    const std::string max_path =
+        charging.battery_path + "/charge_control_limit_max";
+
+    charging.charge_control_limit_readable =
+        access(base.c_str(), R_OK) == 0;
+    charging.charge_control_limit_writable =
+        access(base.c_str(), W_OK) == 0;
+
+    if (charging.charge_control_limit_readable) {
+        charging.charge_control_limit_numeric =
+            readSignedLongLong(base, charging.charge_control_limit_value);
+    }
+
+    if (access(min_path.c_str(), R_OK) == 0) {
+        charging.charge_control_limit_min_available =
+            readSignedLongLong(
+                min_path, charging.charge_control_limit_min
+            );
+    }
+
+    if (access(max_path.c_str(), R_OK) == 0) {
+        charging.charge_control_limit_max_available =
+            readSignedLongLong(
+                max_path, charging.charge_control_limit_max
+            );
+    }
+
+    // Presence/readability/numeric range do not establish the semantic
+    // meaning of this vendor-specific control. Keep semantics unvalidated
+    // until the platform exposes authoritative documentation.
+    charging.charge_control_limit_semantics_validated = false;
+
+    logInfo(
+        "ChargingControlValidation path=%s readable=%s writable=%s "
+        "numeric=%s value=%lld min=%s:%lld max=%s:%lld "
+        "semantics_validated=%s",
+        base.c_str(),
+        charging.charge_control_limit_readable ? "YES" : "NO",
+        charging.charge_control_limit_writable ? "YES" : "NO",
+        charging.charge_control_limit_numeric ? "YES" : "NO",
+        charging.charge_control_limit_value,
+        charging.charge_control_limit_min_available ? "YES" : "NO",
+        charging.charge_control_limit_min,
+        charging.charge_control_limit_max_available ? "YES" : "NO",
+        charging.charge_control_limit_max,
+        charging.charge_control_limit_semantics_validated ? "YES" : "NO"
+    );
+}
+
