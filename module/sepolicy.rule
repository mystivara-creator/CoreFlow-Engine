allow su hal_camera_default dir { read open search getattr }
allow su hal_camera_default file { read open getattr }
allow su mediaserver process { getsched setsched }
allow su mediaserver dir { read open search getattr }
allow su mediaserver file { read open getattr }
allow su mediacodec process { getsched setsched }
allow su mediacodec dir { read open search getattr }
allow su mediacodec file { read open getattr }

allow magisk cameraserver process { getsched setsched }
allow magisk cameraserver dir { read open search getattr }
allow magisk cameraserver file { read open getattr }
allow magisk hal_camera_default process { getsched setsched }
allow magisk hal_camera_default dir { read open search getattr }
allow magisk hal_camera_default file { read open getattr }
allow magisk mediaserver process { getsched setsched }
allow magisk mediaserver dir { read open search getattr }
allow magisk mediaserver file { read open getattr }
allow magisk mediacodec process { getsched setsched }
allow magisk mediacodec dir { read open search getattr }
allow magisk mediacodec file { read open getattr }

# Battery telemetry, thermal step-charging & CFJ4 bypass charging nodes
allow su sysfs_batteryinfo dir { read open search getattr }
allow su sysfs_batteryinfo file { read write open getattr }
allow su sysfs_power dir { read open search getattr }
allow su sysfs_power file { read write open getattr }
allow su sysfs_battery_supply dir { read open search getattr }
allow su sysfs_battery_supply file { read write open getattr }

allow magisk sysfs_batteryinfo dir { read open search getattr }
allow magisk sysfs_batteryinfo file { read write open getattr }
allow magisk sysfs_power dir { read open search getattr }
allow magisk sysfs_power file { read write open getattr }
allow magisk sysfs_battery_supply dir { read open search getattr }
allow magisk sysfs_battery_supply file { read write open getattr }

# v6.1 Live Display Refresh Rate (mi_display / DRM / graphics) & WALT/Sched semantic knobs
allow su sysfs_graphics dir { read open search getattr }
allow su sysfs_graphics file { read open getattr }
allow su proc_sched file { read write open getattr }
allow magisk sysfs_graphics dir { read open search getattr }
allow magisk sysfs_graphics file { read open getattr }
allow magisk proc_sched file { read write open getattr }
